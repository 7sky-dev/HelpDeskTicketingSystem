# Copy to .env.local and fill in:  cp .env.example .env.local
# Only SESSION_SECRET is required; everything else is optional.

# --- Auth (required) ---
# 32+ random chars. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Database (optional; defaults to mongodb://localhost/helpdesk_db) ---
# MONGODB_URI=mongodb://localhost:27017/helpdesk_db
# DB_HOST=localhost
# DB_NAME=helpdesk_db

# --- Integrations (optional; leave empty to disable) ---
# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Port for the bot daemon's internal HTTP bridge used by the web app
BOT_PORT=3001
